# --- AŞAMA 1: Builder ---
FROM node:20-alpine AS builder
WORKDIR /app

# PNPM kurulumu
RUN npm install -g pnpm

# 1. Root dosyaları kopyala
COPY package.json pnpm-lock.yaml* ./

# --- KRİTİK DÜZELTME: Workspace Dosyası Oluşturma ---
# pnpm'in apps klasörünü tanıması için bu dosyayı manuel oluşturuyoruz.
RUN echo 'packages:' > pnpm-workspace.yaml && \
    echo '  - "apps/*"' >> pnpm-workspace.yaml

# 2. Web projesinin package.json'ını kopyala
COPY apps/web/package.json ./apps/web/

# 3. Bağımlılıkları yükle
# Artık workspace dosyası olduğu için pnpm her şeyi doğru bağlayacak.
RUN pnpm install

# 4. Kaynak kodları kopyala
COPY apps/web/ ./apps/web/

# 5. Build
RUN pnpm --filter atos build

# --- AŞAMA 2: Runner ---
FROM node:20-alpine AS runner
WORKDIR /app

RUN npm install -g pnpm

ENV NODE_ENV=production
ENV HOST=0.0.0.0
ENV PORT=4321

# Dosyaları kopyala
COPY --from=builder /app/apps/web/dist ./dist
COPY --from=builder /app/node_modules ./node_modules
COPY --from=builder /app/apps/web/node_modules ./apps/web/node_modules
COPY --from=builder /app/apps/web/package.json ./package.json
COPY --from=builder /app/apps/web/astro.config.mjs ./astro.config.mjs
COPY --from=builder /app/apps/web/tsconfig.json ./tsconfig.json
COPY --from=builder /app/apps/web/public ./public

EXPOSE 4321

CMD ["node", "./dist/server/entry.mjs"]
