# --- AŞAMA 1: Builder (Derleme) ---
FROM node:20-alpine AS builder
WORKDIR /app

# PNPM kurulumu
RUN npm install -g pnpm

# Dosyaları kopyala
COPY package.json pnpm-lock.yaml* ./

# Workspace dosyasını oluştur
RUN echo 'packages:' > pnpm-workspace.yaml && \
    echo '  - "apps/*"' >> pnpm-workspace.yaml

# Web projesi package.json
COPY apps/web/package.json ./apps/web/

# Tüm bağımlılıkları yükle
RUN pnpm install

# Kaynak kodları al
COPY apps/web/ ./apps/web/

# Build al
RUN pnpm --filter atos build

# --- AŞAMA 2: Runner (Canlı Ortam) ---
FROM node:20-alpine AS runner
WORKDIR /app

# PNPM kurulumu
RUN npm install -g pnpm

ENV NODE_ENV=production
ENV HOST=0.0.0.0
ENV PORT=4321

# --- 1. KRİTİK HAMLE: Hoisting (Paketleri yukarı taşıma) ---
# Bu ayar, PNPM'e "Paketleri gizleme, hepsini node_modules içine açıkça koy" der.
# React'in bulunamama sorununu çözen anahtar budur.
RUN echo 'shamefully-hoist=true' > .npmrc

# --- 2. KRİTİK HAMLE: Düzleştirme (Flattening) ---
# Artık apps/web klasörüyle uğraşmıyoruz.
# Web projesinin package.json dosyasını direkt KÖK dizine kopyalıyoruz.
# Böylece Docker bunu tek bir proje sanıyor.
COPY apps/web/package.json ./package.json

# Dependencies'i kur (Lockfile olmadan, çünkü yapı değiştik)
RUN pnpm install --prod

# 3. Dosyaları Kopyala
# Build çıktısını alıyoruz
COPY --from=builder /app/apps/web/dist ./dist
# Config dosyalarını alıyoruz
COPY --from=builder /app/apps/web/astro.config.mjs ./astro.config.mjs
COPY --from=builder /app/apps/web/public ./public

EXPOSE 4321

# Uygulamayı başlat
CMD ["node", "./dist/server/entry.mjs"]
