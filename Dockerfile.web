# --- AŞAMA 1: Builder ---
FROM node:20-alpine AS builder
WORKDIR /app

# PNPM kurulumu
RUN npm install -g pnpm

# Root package.json ve workspace ayarlarını kopyalamak gerekebilir
# Ancak basitlik adına direkt app içine odaklanıyoruz:
COPY apps/web/package.json ./
# Eğer root lock dosyanız varsa onu da kopyalamak iyidir:
# COPY pnpm-lock.yaml ./
