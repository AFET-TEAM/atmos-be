# --- AŞAMA 1: Builder ---
FROM node:20-alpine AS builder
WORKDIR /app

# PNPM kurulumu
RUN npm install -g pnpm

# 1. Root dosyaları kopyala
COPY package.json pnpm-lock.yaml* ./

# 2. Web projesinin package.json'ını kopyala
COPY apps/web/package.json ./apps/web/

# 3. Bağımlılıkları yükle (Kök dizindeki node_modules'a yükler)
RUN pnpm install

# 4. Kaynak kodları kopyala
COPY apps/web/ ./apps/web/

# --- KRİTİK DÜZELTME BURADA ---
# Dizin değiştirmek yerine (WORKDIR /app/apps/web yapmadan)
# Kök dizinden "atos" isimli projeyi build et diyoruz.
# Böylece üst klasördeki node_modules'a erişebilir.
RUN pnpm --filter atos build

# --- AŞAMA 2: Runner ---
FROM node:20-alpine AS runner
WORKDIR /app

RUN npm install -g pnpm

ENV NODE_ENV=production
ENV HOST=0.0.0.0
ENV PORT=4321

# 1. Build edilen dosyaları al (Builder'da dist apps/web altında oluştu)
COPY --from=builder /app/apps/web/dist ./dist

# 2. node_modules'u al
COPY --from=builder /app/node_modules ./node_modules
COPY --from=builder /app/apps/web/node_modules ./apps/web/node_modules

# 3. Gerekli config dosyalarını al
COPY --from=builder /app/apps/web/package.json ./package.json
COPY --from=builder /app/apps/web/astro.config.mjs ./astro.config.mjs
# Eğer varsa tsconfig'i de alalım
COPY --from=builder /app/apps/web/tsconfig.json ./tsconfig.json

# Public klasörü (resimler vs için)
COPY --from=builder /app/apps/web/public ./public

EXPOSE 4321

# Preview komutu
CMD ["pnpm", "run", "preview", "--host"]
