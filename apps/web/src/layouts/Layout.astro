---
import Header from "@/components/Global/Header/Header.astro";
import Sidebar from "@/components/Global/Sidebar/Sidebar.astro";
import NotificationModal from "@/components/UI/NotificationModal.svelte";
import { currentUser } from "@/utils/user";
import { ClientRouter } from "astro:transitions";

const user = currentUser();
const { title } = Astro.props;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <meta name="generator" content={Astro.generator} />
    <title>ATOS - {title}</title>
    <ClientRouter />
  </head>
  <body>
    <div class="layout">
        <aside class="sidebar-container" id="app-sidebar">
        <Sidebar />
      </aside>
        <div class="sidebar-backdrop" id="sidebar-backdrop"></div>
      <main>
       <Header user={user} />
        <slot />
      </main>
    </div>
     <NotificationModal client:load />

      <script is:inline>
      const initSidebarToggle = () => {
        const sidebar = document.getElementById("app-sidebar");
        const backdrop = document.getElementById("sidebar-backdrop");
        const buttons = document.querySelectorAll("[data-toggle-sidebar]");

        if (!sidebar || !backdrop || !buttons.length) return;
        if (sidebar.dataset.init === "true") return;
        sidebar.dataset.init = "true";

        const toggleMenu = () => {
          const isOpen = sidebar.classList.toggle("sidebar-open");
          backdrop.classList.toggle("visible", isOpen);
          document.body.classList.toggle("menu-open", isOpen);
        };

        buttons.forEach((btn) => {
          btn.addEventListener("click", toggleMenu);
        });

        backdrop.addEventListener("click", toggleMenu);
      };

      document.addEventListener("astro:page-load", initSidebarToggle);
    </script>
  </body>
</html>

<style>
  html,
  body {
    margin: 0;
    width: 100%;
    height: 100%;
    background-color: #fafafa;
  }

 .layout {
  display: flex;
  min-height: 100vh;
  padding: 10px;
  box-sizing: border-box;
}

.sidebar-container {
  width: 250px;
  margin-right: 1.2rem;
  position: sticky;
  top: 10px;
  height: calc(100vh - 20px);
  overflow-y: auto;
}

main {
  flex: 1;
  padding: 2rem;
  box-sizing: border-box;
}

@media (max-width: 768px) {
  .layout {
    padding: 0;
  }

  .sidebar-container {
    position: fixed;
    top: 0.75rem;
    bottom: 0.75rem;
    left: 0.75rem;
    right: 0.75rem;
    width: auto;
    margin: 0;
    background: #ffffff;
    z-index: 1001;
    transform: translateX(calc(100% + 1.5rem));
    transition: transform 0.28s ease-out;
    border-radius: 32px;
    box-shadow: 0 0 24px rgba(0, 0, 0, 0.12);
    overflow-y: auto;
  }

  .sidebar-container.sidebar-open {
    transform: translateX(0);
  }

  main {
    width: 100%;
    margin: 0;
    padding: 1.5rem 0.75rem;
  }
}

.sidebar-backdrop {
  position: fixed;
  inset: 0;
  background: rgba(0, 0, 0, 0.18);
  opacity: 0;
  pointer-events: none;
  transition: opacity 0.2s ease;
  z-index: 1000;
}

.sidebar-backdrop.visible {
  opacity: 1;
  pointer-events: auto;
}

body.menu-open {
  overflow: hidden;
}

</style>
