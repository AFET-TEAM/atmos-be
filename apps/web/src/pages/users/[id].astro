---
export const prerender = false;

import Layout from "@/components/Layout.astro";
import Card from "@/components/Card.astro";
import { get, patch, del } from "@/lib/api";

const id = Number(Astro.params.id!);
let user = await get<any>(`/users/${id}`);

const url = new URL(Astro.request.url);

async function parseBodySafely(req: Request) {
  try {
    const fd = await req.formData();
    return Object.fromEntries(fd.entries());
  } catch {
    try { return await req.json(); } catch { return null; }
  }
}

let message = "";
if (Astro.request.method === "POST") {
  const payload:any = await parseBodySafely(Astro.request);
  if (payload) {
    try {
      const action = String(payload.action || "");
      if (action === "update") {
        user = await patch(`/users/${id}`, {
          full_name: payload.full_name ?? user.fullName ?? "",
          team: payload.team || undefined,
          profession: payload.profession || undefined,
          profile_picture: payload.profile_picture || undefined,
          address: payload.address || undefined,
          connection: payload.connection === "on" ? true :
                      payload.connection === true ? true : undefined,
          user_status_id: payload.user_status_id ? Number(payload.user_status_id) : undefined
        });
        message = "Updated.";
      } else if (action === "delete") {
        await del(`/users/${id}`);
        return Astro.redirect(`/users?${url.searchParams.toString()}`);
      }
    } catch (e:any) {
      message = e.message || String(e);
    }
  }
}
---

<Layout title={`User #${id}`}>
  <Card title="User">
    {message && <div class="badge">{message}</div>}

    <form method="POST" enctype="application/x-www-form-urlencoded" class="grid">
      <input type="hidden" name="action" value="update" />

      <label class="full">
        <span>Email (read-only)</span>
        <input value={user.email || ""} readonly />
      </label>

      <label class="full">
        <span>Full Name</span>
        <input name="full_name" value={user.fullName || ""} />
      </label>

      <label>
        <span>Team</span>
        <input name="team" value={user.team || ""} />
      </label>

      <label>
        <span>Profession</span>
        <input name="profession" value={user.profession || ""} />
      </label>

      <label class="full">
        <span>Profile Picture URL</span>
        <input name="profile_picture" value={user.profilePicture || ""} placeholder="https://…" />
      </label>

      <label class="full">
        <span>Address</span>
        <input name="address" value={user.address || ""} />
      </label>

      <label>
        <span>Connection</span>
        <input type="checkbox" name="connection" checked={!!user.connection} />
      </label>

      <label>
        <span>Status ID</span>
        <input type="number" name="user_status_id" value={user.userStatusId ?? ""} />
      </label>

      <div class="full" style="display:flex; gap:.6rem; align-items:center;">
        <button class="primary" type="submit">Save</button>

        <form method="POST" enctype="application/x-www-form-urlencoded" onsubmit="return confirm('Delete this user?')">
          <input type="hidden" name="action" value="delete" />
          <button class="badge danger" type="submit">Delete</button>
        </form>
      </div>
    </form>

    <pre style="margin-top:16px;">{JSON.stringify(user, null, 2)}</pre>
  </Card>

  <style lang="scss">
    .grid { display:grid; grid-template-columns: repeat(2, minmax(0,1fr)); gap:.6rem .8rem; max-width:820px; }
    .grid .full { grid-column: 1 / -1; }
    .badge { border:1px solid #ccc; padding:.3rem .5rem; border-radius:.4rem; background:#fafafa; }
    .badge.danger { border-color:#e04545; color:#e04545; }
    .primary { padding:.45rem .75rem; border:1px solid #ddd; border-radius:.5rem; background:#222; color:#fff; cursor:pointer; }
  </style>
</Layout>
