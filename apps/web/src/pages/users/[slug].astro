---
import MeetList from "@/components/Users/MeetList/MeetList.astro";
import TabsWrapper from "@/components/Users/TabMenu/TabsWrapper.svelte";
import UserMembers from "@/components/Users/UserMembers/UserMembers.astro";
import UserProfileCard from "@/components/Users/UserProfileCard/UserProfileCard.astro";
import Layout from "../../layouts/Layout.astro";
import "./_users.scss";

import { getUserMeetings, getUsers } from "@/api/UsersApi";

const slugParam = Astro.params.slug;

if (!slugParam) {
  throw new Error("Geçersiz kullanıcı slug");
}

const toSlug = (s: string) =>
  s
    .trim()
    .toLowerCase()
    .replace(/\u00A0/g, " ")
    .replace(/\s+/g, "-");

const slugFromUrl = decodeURIComponent(slugParam).trim().toLowerCase();

const users = await getUsers();

const user = users.find((u: any) => {
  const fullName = String(u.fullName ?? u.full_name ?? "");
  return toSlug(fullName) === slugFromUrl;
});

if (!user) {
  throw new Error("Kullanıcı bulunamadı");
}
const userId = user.id;

const userMeetings = await getUserMeetings(String(userId));

const meets = userMeetings?.map((meet: any) => ({
  ...meet,
  title: meet.title,
  time: meet.time,
}));
---

<Layout title="User Detail">
  <header class="page-top">
    <UserProfileCard user={user} />
    <UserMembers user={user} />
  </header>

  <main class="page-content">
    <MeetList meets={meets} />
    <TabsWrapper userId={String(userId)} client:load />
  </main>
</Layout>
