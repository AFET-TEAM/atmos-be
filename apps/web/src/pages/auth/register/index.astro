---
import { getDepartments, registerUser, getCities , getTeams, getDirectorates} from "@/api/AuthApi";
import AuthLayout from "../../../layouts/AuthLayout.astro";
import { get } from 'svelte/store';


let errorMessage = "";
const departments = await getDepartments();
const teams = await getTeams();
const cities = await getCities();
const directorates = await getDirectorates();

if (Astro.request.method === "GET") {
  const authCookie = Astro.cookies.get("auth");
  if (authCookie) {
    return Astro.redirect("/dashboard");
  }
}

if (Astro.request.method === "POST") {
  try {
    const data = await Astro.request.formData();
    const name = data.get("name")?.toString();
    const email = data.get("email")?.toString();
    const password = data.get("password")?.toString();
    const passwordAgain = data.get("passwordAgain")?.toString();
    const user_department = Number(data.get("department"));
    const team = data.get("teams")?.toString();
    const directorate = Number(data.get("directorate"));
    const address = data.get("city")?.toString();

    if (!name || !email || !password || !passwordAgain || !user_department || !address) {
      errorMessage = "Tüm alanlar zorunludur";
    } else if (password !== passwordAgain) {
      errorMessage = "Şifreler eşleşmiyor";
    } else {
      await registerUser(email, password, name, user_department, address, team, directorate);
      return Astro.redirect("/auth/login");
    }
  } catch (error: any) {
    errorMessage = "Kayıt sırasında bir hata oluştu";
  }
}
---

<AuthLayout title="Kayıt Ol - ATOS">
  <section class="authWrapper">
    <form method="POST" class="form-container">
      <h2>Kayıt Ol</h2>
      <p class="subtitle">Hesabınızı oluşturun ve başlayın</p>

      {errorMessage && <div class="error-message">{errorMessage}</div>}

      <div class="form-group">
        <label for="name">Kullanıcı Adı</label>
        <div class="input-wrapper">
          <span class="input-icon">👤</span>
          <input
            type="text"
            id="name"
            name="name"
            placeholder="Kullanıcı adınızı girin"
            required
          />
        </div>
      </div>

      <div class="form-group">
        <label for="email">E-posta Adresi</label>
        <div class="input-wrapper">
          <span class="input-icon">📧</span>
          <input
            type="email"
            id="email"
            name="email"
            placeholder="ornek@email.com"
            required
          />
        </div>
      </div>

      <div class="form-group">
        <label for="password">Şifre</label>
        <div class="input-wrapper">
          <span class="input-icon">🔒</span>
          <input
            type="password"
            id="password"
            name="password"
            placeholder="Güçlü bir şifre seçin"
            required
          />
        </div>
      </div>

      <div class="form-group">
        <label for="passwordAgain">Şifre Tekrar</label>
        <div class="input-wrapper">
          <span class="input-icon">🔐</span>
          <input
            type="password"
            id="passwordAgain"
            name="passwordAgain"
            placeholder="Şifrenizi tekrar girin"
            required
          />
        </div>
      </div>

         <div class="form-group">
        <label for="teams">Takım</label>
        <div class="input-wrapper">
          <span class="input-icon">🏢</span>
          <select id="teams" name="teams" required>
            <option value="" disabled selected>Takımınızı seçin</option>
            {teams.map((team: { id: string; name: string }) => (
              <option value={team.id}>{team.name}</option>
            ))}
          </select>
        </div>
      </div>

      <div class="form-group">
        <label for="department">Departman</label>
        <div class="input-wrapper">
          <span class="input-icon">🏢</span>
          <select id="department" name="department" required>
            <option value="" disabled selected>Departmanınızı seçin</option>
            {departments.map((dept: { id: number; name: string }) => (
              <option value={dept.id}>{dept.name}</option>
            ))}
          </select>
        </div>
      </div>

      <div class="form-group">
        <label for="directorate">Direktörlük</label>
        <div class="input-wrapper">
          <span class="input-icon">🏢</span>
          <select id="directorate" name="directorate" required>
            <option value="" disabled selected>Direktörlüğünüzü seçin</option>
            {directorates.map((dept: { id: number; name: string }) => (
              <option value={dept.id}>{dept.name}</option>
            ))}
          </select>
        </div>
      </div>

      <div class="form-group">
        <label for="city">Şehir</label>
        <div class="input-wrapper">
          <span class="input-icon">🏙️</span>
          <select id="city" name="city" required>
            <option value="" disabled selected>Şehir seçin</option>
            {cities.map((city: { id: string; name: string }) => (
              <option value={city.name}>{city.name}</option>
            ))}
          </select>
        </div>
      </div>

      <button type="submit" class="submit-button">Hesap Oluştur</button>

      <p class="auth-link">
        Zaten hesabınız var mı? <a href="/auth/login">Giriş Yapın</a>
      </p>
    </form>
  </section>

  <script>
    import { tokenManager } from '@/axios/axiosInstance';

    document.addEventListener('DOMContentLoaded', () => {
      const cookieToken = document.cookie
        .split('; ')
        .find(row => row.startsWith('auth='))
        ?.split('=')[1];

      if (cookieToken) {
        tokenManager.setToken(cookieToken);
        window.location.href = '/dashboard';
      }
    });
  </script>
</AuthLayout>
