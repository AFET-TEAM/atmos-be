---
import AuthLayout from "../../layouts/AuthLayout.astro";

let successMessage = "";
let errorMessage = "";

if (Astro.request.method === "POST") {
  try {
    const data = await Astro.request.formData();
    const email = data.get("email")?.toString();

    if (!email) {
      errorMessage = "E-posta adresi gerekli";
    } else {
      const apiBase = import.meta.env.API_URL || "http://localhost:3000/v1";
      const res = await fetch(`${apiBase}/auth/forgot-password`, {
        method: "POST",
        headers: { "Content-Type": "application/json" },
        body: JSON.stringify({ email }),
      });

      if (res.ok) {
        successMessage =
          "Şifre sıfırlama bağlantısı e-posta adresinize gönderildi. Lütfen gelen kutunuzu kontrol edin.";
      } else {
        errorMessage = "İşlem sırasında bir hata oluştu. Lütfen tekrar deneyin.";
      }
    }
  } catch (_error) {
    errorMessage = "Sunucuya bağlanılamadı. Lütfen tekrar deneyin.";
  }
}
---

<AuthLayout title="Şifremi Unuttum - ATOS">
  <section class="authWrapper">
    <form method="POST" class="form-container">
      <h2>Şifremi Unuttum</h2>
      <p class="subtitle">
        E-posta adresinizi girin, size sıfırlama bağlantısı gönderelim
      </p>

      {errorMessage && <div class="error-message">{errorMessage}</div>}

      {
        successMessage && (
          <div class="success-message">{successMessage}</div>
        )
      }

      {
        !successMessage && (
          <>
            <div class="form-group">
              <label for="email">E-posta Adresi</label>
              <div class="input-wrapper">
                <span class="input-icon">📧</span>
                <input
                  type="email"
                  id="email"
                  name="email"
                  placeholder="ornek@email.com"
                  required
                />
              </div>
            </div>

            <button type="submit" class="submit-button">
              Sıfırlama Bağlantısı Gönder
            </button>
          </>
        )
      }

      <p class="auth-link">
        Şifrenizi hatırladınız mı? <a href="/auth/login">Giriş Yap</a>
      </p>
    </form>
  </section>
</AuthLayout>

<style>
  .success-message {
    background: linear-gradient(135deg, #48bb78, #38a169);
    color: white;
    padding: 0.75rem 1rem;
    border-radius: 10px;
    margin-bottom: 1.5rem;
    font-size: 0.9rem;
    font-weight: 500;
    box-shadow: 0 4px 15px rgba(72, 187, 120, 0.3);
  }
</style>
