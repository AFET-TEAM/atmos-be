---
import { loginUser } from "@/api/AuthApi";
import AuthLayout from "../../../layouts/AuthLayout.astro";

let errorMessage = "";
let successMessage = "";

if (Astro.request.method === "GET") {
  successMessage = Astro.url.searchParams.get("reset") === "success"
    ? "Şifreniz başarıyla güncellendi! Yeni şifrenizle giriş yapabilirsiniz."
    : "";
  const authCookie = Astro.cookies.get("auth");
  const token = authCookie?.value;

  // Token varsa ve geçerliyse dashboard'a yönlendir
  if (token && token.trim() !== "") {
    try {
      const payload = JSON.parse(atob(token.split(".")[1]));
      const currentTime = Math.floor(Date.now() / 1000);

      // Token hala geçerliyse dashboard'a git
      if (payload.exp >= currentTime) {
        return Astro.redirect("/dashboard");
      }
    } catch (error) {
      // Token geçersizse cookie'leri temizle
      Astro.cookies.delete("auth");
      Astro.cookies.delete("user");
    }
  }
}

if (Astro.request.method === "POST") {
  try {
    const data = await Astro.request.formData();
    const email = data.get("email")?.toString();
    const password = data.get("password")?.toString();

    if (!email || !password) {
      errorMessage = "E-posta ve şifre gerekli";
    } else {
      const response = await loginUser(email, password);

      if (response.token) {
        Astro.cookies.set("auth", response.token, {
          path: "/",
          maxAge: 60 * 60 * 24 * 7,
          httpOnly: false,
          secure: false,
          sameSite: "lax"
        });

        Astro.cookies.set("user", JSON.stringify(response.user), {
          path: "/",
          maxAge: 60 * 60 * 24 * 7,
          httpOnly: false,
          secure: false,
          sameSite: "lax"
        });


        return Astro.redirect("/dashboard");
      }
    }
  } catch (error: any) {
    const errorInfo = {
      message: error.message,
      status: error.response?.status,
      data: error.response?.data
    };
    console.error("Login error:", errorInfo);
    errorMessage = error.response?.data?.message || "Giriş sırasında bir hata oluştu";
  }
}
---


<AuthLayout title="Giriş Yap - ATOS">
  <section class="authWrapper">
    <form method="POST" class="form-container">
      <h2>Hoş Geldiniz</h2>
      <p class="subtitle">Hesabınıza giriş yapın</p>

      {errorMessage && <div class="error-message">{errorMessage}</div>}
      {successMessage && <div class="success-message">{successMessage}</div>}

      <div class="form-group">
        <label for="email">E-posta Adresi</label>
        <div class="input-wrapper">
          <span class="input-icon">📧</span>
          <input
            type="email"
            id="email"
            name="email"
            placeholder="ornek@email.com"
            required
          />
        </div>
      </div>

      <div class="form-group">
        <label for="password">Şifre</label>
        <div class="input-wrapper">
          <span class="input-icon">🔒</span>
          <input
            type="password"
            id="password"
            name="password"
            placeholder="Şifrenizi girin"
            required
          />
        </div>
      </div>

      <button type="submit" class="submit-button">Giriş Yap</button>

      <div class="forgot-password">
        <a href="/auth/forgot-password">Şifremi unuttum</a>
      </div>

      <p class="auth-link">
        Hesabınız yok mu? <a href="/auth/register">Kayıt Olun</a>
      </p>
    </form>
  </section>

  <script>
    import { tokenManager } from '@/axios/axiosInstance';
import { userAtom } from '@/stores/userStore';

    document.addEventListener('DOMContentLoaded', () => {

      const cookieToken = document.cookie
        .split('; ')
        .find(row => row.startsWith('auth='))
        ?.split('=')[1];

      const cookieUser = document.cookie
        .split('; ')
        .find(row => row.startsWith('user='))
        ?.split('=')[1];

      if (cookieToken) {
        tokenManager.setToken(cookieToken);

        if (cookieUser) {
          try {
            const userData = JSON.parse(decodeURIComponent(cookieUser));
            tokenManager.setUser(userData);
            userAtom.set(userData);
          } catch (e) {
            console.error('User cookie parse error:', e);
          }
        }
      }
    });
  </script>

  <style>
    .success-message {
      background: linear-gradient(135deg, #48bb78, #38a169);
      color: white;
      padding: 0.75rem 1rem;
      border-radius: 10px;
      margin-bottom: 1.5rem;
      font-size: 0.9rem;
      font-weight: 500;
      box-shadow: 0 4px 15px rgba(72, 187, 120, 0.3);
    }
  </style>
</AuthLayout>
