---
import Card from "@/components/Card.astro";
import Layout from "@/components/Layout.astro";
import Pager from "@/components/Pager.astro";
import { del, get, paginateDefaults, patch, post } from "@/lib/api";

const url = new URL(Astro.request.url);
const limit = Number(url.searchParams.get("limit") ?? paginateDefaults.limit);
const offset = Number(url.searchParams.get("offset") ?? paginateDefaults.offset);
const flash = url.searchParams.get("flash") || "";

let rows = await get<any[]>("/tasks", { limit, offset });

const ct = (Astro.request.headers.get("content-type") || "").toLowerCase();
const isPost = Astro.request.method === "POST";
const isForm = isPost && (ct.includes("application/x-www-form-urlencoded") || ct.startsWith("multipart/form-data"));
const isJson = isPost && ct.includes("application/json");

let msg = flash ? (flash === "created" ? "Task created." : flash) : "";
let err = "";

if (isForm || isJson) {
  try {
    const p = isJson ? await Astro.request.json() : Object.fromEntries((await Astro.request.formData()).entries());
    const action = String(p.action || "");

    if (action === "create") {
      await post("/tasks", {
        title: String(p.title),
        description: p.description ? String(p.description) : undefined,
        created_by: p.created_by ? Number(p.created_by) : undefined,
        assigned_to: p.assigned_to ? Number(p.assigned_to) : undefined,
        due_date: p.due_date ? String(p.due_date) : undefined,
        task_status_id: p.task_status_id ? Number(p.task_status_id) : undefined,
        related_type: p.related_type || undefined,
        related_id: p.related_id ? Number(p.related_id) : undefined
      });
      return Astro.redirect(`/tasks?limit=${limit}&offset=0&flash=created`);
    } else if (action === "update") {
      const id = Number(p.id);
      await patch(`/tasks/${id}`, {
        title: String(p.title),
        description: p.description ? String(p.description) : undefined,
        assigned_to: p.assigned_to ? Number(p.assigned_to) : undefined,
        due_date: p.due_date ? String(p.due_date) : undefined,
        task_status_id: p.task_status_id ? Number(p.task_status_id) : undefined
      });
      return Astro.redirect(`/tasks?limit=${limit}&offset=${offset}&flash=updated`);
    } else if (action === "delete") {
      await del(`/tasks/${Number(p.id)}`);
      return Astro.redirect(`/tasks?limit=${limit}&offset=0&flash=deleted`);
    }
  } catch (e:any) {
    err = e.message || String(e);
  }
}
---

<Layout title="Tasks">
  <Card title="Create Task">
    {msg && <div class="badge" style="border-color:#2a7; color:#2a7">🟢 {msg}</div>}
    {err && <div class="badge" style="border-color:#e04545; color:#e04545">🔴 {err}</div>}
    <form method="POST" enctype="application/x-www-form-urlencoded" class="grid">
      <input type="hidden" name="action" value="create" />
      <label class="full"><span>Title</span><input name="title" required /></label>
      <label class="full"><span>Description</span><input name="description" /></label>
      <label><span>Created By (user_id)</span><input name="created_by" type="number" /></label>
      <label><span>Assigned To (user_id)</span><input name="assigned_to" type="number" /></label>
      <label><span>Due Date</span><input type="date" name="due_date" /></label>
      <label><span>Status ID</span><input type="number" name="task_status_id" /></label>
      <label><span>Related Type</span><input name="related_type" placeholder="techtalk|document|report|idea|meeting" /></label>
      <label><span>Related ID</span><input name="related_id" type="number" /></label>
      <div class="full"><button class="primary" type="submit">Add</button></div>
    </form>
  </Card>

  <Card title="Tasks">
    {rows?.length ? (
      <>
        <table class="tbl">
          <thead>
            <tr>
              <th>ID</th>
              <th>Title</th>
              <th>Assigned</th>
              <th>Status</th>
              <th>Due</th>
              <th style="width:560px;">Actions</th>
            </tr>
          </thead>
          <tbody>
            {rows.map((r:any) => (
              <tr>
                <td>{r.id}</td>
                <td class="clip">{r.title}</td>
                <td>{r.assignedTo ?? ""}</td>
                <td>{r.taskStatusId ?? ""}</td>
                <td>{r.dueDate ?? ""}</td>
                <td>
                  <div class="actions">
                    <form method="POST" class="form-inline">
                      <input type="hidden" name="action" value="update" />
                      <input type="hidden" name="id" value={r.id} />
                      <input name="title" value={r.title} placeholder="title" style="min-width:180px" />
                      <input name="description" value={r.description || ""} placeholder="description" style="min-width:220px" />
                      <input name="assigned_to" type="number" value={r.assignedTo || ""} placeholder="assigned_to" />
                      <input name="task_status_id" type="number" value={r.taskStatusId || ""} placeholder="status_id" />
                      <input type="date" name="due_date" value={r.dueDate || ""} />
                      <button class="badge" type="submit">Save</button>
                    </form>
                    <form method="POST" class="form-inline">
                      <input type="hidden" name="action" value="delete" />
                      <input type="hidden" name="id" value={r.id} />
                      <button class="badge danger" type="submit">Delete</button>
                    </form>
                  </div>
                </td>
              </tr>
            ))}
          </tbody>
        </table>
        <Pager basePath="/tasks" limit={limit} offset={offset} />
      </>
    ) : (
      <p class="muted">No tasks found.</p>
    )}
  </Card>

  <style lang="scss">
    .grid { display:grid; grid-template-columns: repeat(2, minmax(0,1fr)); gap:.6rem .8rem; }
    .grid .full { grid-column: 1 / -1; }
    .grid label { display:flex; flex-direction:column; gap:.3rem; }
    .tbl { width:100%; border-collapse:collapse; background:#fff; border:1px solid #eee; }
    th, td { padding:.6rem .5rem; border-bottom:1px solid #f0f0f0; vertical-align:top; text-align:left; }
    .clip { max-width:260px; white-space:nowrap; overflow:hidden; text-overflow:ellipsis; }
    .actions { display:flex; gap:.5rem; align-items:center; flex-wrap:wrap; }
    .form-inline { display:inline-flex; gap:.5rem; align-items:center; flex-wrap:wrap; }
    .badge { border:1px solid #ccc; padding:.3rem .5rem; border-radius:.4rem; background:#fafafa; cursor:pointer; text-decoration:none; }
    .badge.danger { border-color:#e04545; color:#e04545; }
    .primary { padding:.45rem .75rem; border:1px solid #ddd; border-radius:.5rem; background:#222; color:#fff; cursor:pointer; }
    .muted { color:#666; }
  </style>
</Layout>
