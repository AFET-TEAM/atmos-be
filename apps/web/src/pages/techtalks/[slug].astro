---
import { fetchTechTalk, fetchTechTalks } from "@/api/TechTalksApi";
import TechTalkDetail from "@/components/Techtalks/TechtalkDetail.astro";
import type { TechTalk } from "@/components/Techtalks/types/TechTalks";
import Layout from "@/layouts/Layout.astro";

const slugParam = Astro.params.slug ?? "";

const idStr = slugParam.split("-").pop() ?? "";
const id = Number(idStr);

if (!idStr || Number.isNaN(id)) {
  Astro.response.status = 404;
  throw new Error("Geçersiz slug/id");
}

let talk: TechTalk;

try {
  talk = await fetchTechTalk(id);
} catch (err) {
  console.error("🔴 fetchTechTalk hata:", err);
  Astro.response.status = 404;
  throw new Error("TechTalk bulunamadı");
}

const all: TechTalk[] = await fetchTechTalks();
const others: TechTalk[] = all.filter((t) => Number(t.id) !== id);
---

<Layout title={`TechTalk • ${talk.title}`}>
  <TechTalkDetail talk={talk} others={others} />
</Layout>
