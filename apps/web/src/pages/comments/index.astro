---
import Card from "@/components/Card.astro";
import Layout from "@/components/Layout.astro";
import { del, get, patch, post } from "@/lib/api";

const url = new URL(Astro.request.url);
const target_type = url.searchParams.get("target_type") || "";
const target_id = url.searchParams.get("target_id") || "";
const include_deleted = url.searchParams.get("include_deleted") === "true";
const page = Number(url.searchParams.get("page") || 1);
const limit = Number(url.searchParams.get("limit") || 20);
const offset = (page - 1) * limit;

const q: any = { limit, offset };
if (target_type) q.target_type = target_type;
if (target_id) q.target_id = Number(target_id);
if (include_deleted) q.include_deleted = true;

let rows = await get<any[]>("/comments", q);
let msg = "";

if (Astro.request.method === "POST") {
  const form = await Astro.request.formData();
  const action = String(form.get("action") || "");
  try {
    if (action === "create") {
      await post("/comments", {
        user_id: Number(form.get("user_id")),
        target_type: String(form.get("target_type")),
        target_id: Number(form.get("target_id")),
        text: String(form.get("text"))
      });
    } else if (action === "update") {
      await patch(`/comments/${Number(form.get("id"))}`, {
        text: String(form.get("text"))
      });
    } else if (action === "delete") {
      await del(`/comments/${Number(form.get("id"))}`);
    }
    // filtreleri koru
    const params = new URLSearchParams({
      ...(target_type ? { target_type } : {}),
      ...(target_id ? { target_id } : {}),
      ...(include_deleted ? { include_deleted: "true" } : {}),
      page: String(page),
      limit: String(limit)
    });
    return Astro.redirect(`/comments?${params.toString()}`);
  } catch (e: any) {
    msg = e.message || String(e);
  }
}

const mkLink = (p: number) => {
  const sp = new URLSearchParams({
    ...(target_type ? { target_type } : {}),
    ...(target_id ? { target_id } : {}),
    ...(include_deleted ? { include_deleted: "true" } : {}),
    page: String(p),
    limit: String(limit)
  });
  return `/comments?${sp.toString()}`;
};
---

<Layout title="Comments">
  <Card title="Filter">
    <form method="GET" class="toolbar">
      <input name="target_type" placeholder="target_type" value={target_type} />
      <input name="target_id" placeholder="target_id" value={target_id} />
      <label style="display:flex;align-items:center;gap:.4rem;">
        <input type="checkbox" name="include_deleted" value="true" checked={include_deleted} />
        include_deleted
      </label>
      <input type="number" name="limit" min="5" max="100" step="5" value={limit} style="width:90px" />
      <button class="primary" type="submit">Apply</button>
    </form>
  </Card>

  <Card title="Create Comment">
    {msg && <div class="badge">{msg}</div>}
    <form method="POST" class="toolbar">
      <input type="hidden" name="action" value="create" />
      <input name="user_id" placeholder="user_id" required />
      <input name="target_type" placeholder="target_type" required />
      <input name="target_id" placeholder="target_id" required />
      <input name="text" placeholder="text" required />
      <button class="primary" type="submit">Add</button>
    </form>
  </Card>

  <Card title="Comments">
    {rows?.length ? (
      <>
        <table class="tbl">
          <thead>
            <tr>
              <th>ID</th>
              <th>Type</th>
              <th>Target</th>
              <th>Text</th>
              <th>User</th>
              <th style="width: 360px;">Actions</th>
            </tr>
          </thead>
          <tbody>
            {rows.map((r: any) => (
              <tr>
                <td><a href={`/comments/${r.id}`}>{r.id}</a></td>
                <td>{r.targetType}</td>
                <td>{r.targetId}</td>
                <td class="clip">{r.text}</td>
                <td>{r.userId}</td>
                <td>
                  <div class="actions">
                    <form method="POST" class="form-inline">
                      <input type="hidden" name="action" value="update" />
                      <input type="hidden" name="id" value={r.id} />
                      <input name="text" value={r.text} />
                      <button class="badge" type="submit">Save</button>
                    </form>
                    <form method="POST" class="form-inline">
                      <input type="hidden" name="action" value="delete" />
                      <input type="hidden" name="id" value={r.id} />
                      <button class="badge danger" type="submit">Delete</button>
                    </form>
                    <a class="badge" href={`/comments/${r.id}`}>Detail</a>
                  </div>
                </td>
              </tr>
            ))}
          </tbody>
        </table>

        <div class="pager">
          <a class="badge" href={mkLink(Math.max(1, page - 1))} aria-disabled={page<=1}>« Prev</a>
          <span>Page {page}</span>
          <a class="badge" href={mkLink(page + 1)}>Next »</a>
        </div>
      </>
    ) : (
      <p class="muted">No comments found.</p>
    )}
  </Card>

  <style lang="scss">
    .toolbar { display:flex; gap:.5rem; flex-wrap:wrap; }
    .tbl { width:100%; border-collapse:collapse; background:#fff; border:1px solid #eee; }
    th, td { padding:.6rem .5rem; border-bottom:1px solid #f0f0f0; vertical-align:top; text-align:left; }
    .clip { max-width:420px; white-space:nowrap; overflow:hidden; text-overflow:ellipsis; }
    .actions { display:flex; gap:.5rem; align-items:center; flex-wrap:wrap; }
    .form-inline { display:inline-flex; gap:.5rem; align-items:center; }
    .badge { border:1px solid #ccc; padding:.3rem .5rem; border-radius:.4rem; background:#fafafa; cursor:pointer; text-decoration:none; }
    .badge[aria-disabled="true"] { opacity:.4; pointer-events:none; }
    .badge.danger { border-color:#e04545; color:#e04545; }
    .primary { padding:.45rem .75rem; border:1px solid #ddd; border-radius:.5rem; background:#222; color:#fff; cursor:pointer; }
    .muted { color:#666; }
    .pager { margin-top:.8rem; display:flex; gap:.6rem; align-items:center; }
  </style>
</Layout>
