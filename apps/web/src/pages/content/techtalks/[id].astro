---
import Layout from "@/components/Layout.astro";
import Card from "@/components/Card.astro";
import { get, patch, del } from "@/lib/api";

const id = Number(Astro.params.id!);
let row = await get<any>(`/techtalks/${id}`);

const ct = (Astro.request.headers.get("content-type") || "").toLowerCase();
const isPost = Astro.request.method === "POST";
const isForm = isPost && (ct.includes("application/x-www-form-urlencoded") || ct.startsWith("multipart/form-data"));
const isJson = isPost && ct.includes("application/json");

let msg = "";
if (isForm || isJson) {
  try {
    const p = isJson ? await Astro.request.json() : Object.fromEntries((await Astro.request.formData()).entries());
    const action = String(p.action || "");
    if (action === "update") {
      row = await patch(`/techtalks/${id}`, {
        title: String(p.title || row.title),
        description: p.description ? String(p.description) : undefined,
        location: p.location ? String(p.location) : undefined,
        duration_min: p.duration_min ? Number(p.duration_min) : undefined,
        video_url: p.video_url ? String(p.video_url) : undefined,
        thumbnail_url: p.thumbnail_url ? String(p.thumbnail_url) : undefined,
        date: p.date ? String(p.date) : undefined
      });
      msg = "Updated.";
    } else if (action === "delete") {
      await del(`/techtalks/${id}`);
      return Astro.redirect("/content/techtalks");
    }
  } catch (e:any) { msg = e.message || String(e); }
}
---

<Layout title={`Techtalk #${id}`}>
  <Card title="Techtalk">
    {msg && <div class="badge">{msg}</div>}
    <form method="POST" enctype="application/x-www-form-urlencoded" class="grid">
      <input type="hidden" name="action" value="update" />
      <label class="full"><span>Title</span><input name="title" value={row.title || ""} /></label>
      <label class="full"><span>Description</span><input name="description" value={row.description || ""} /></label>
      <label><span>Location</span><input name="location" value={row.location || ""} /></label>
      <label><span>Duration (min)</span><input type="number" name="duration_min" value={row.durationMin ?? ""} /></label>
      <label class="full"><span>Video URL</span><input name="video_url" value={row.videoUrl || ""} /></label>
      <label class="full"><span>Thumbnail URL</span><input name="thumbnail_url" value={row.thumbnailUrl || ""} /></label>
      <label><span>Date</span><input type="date" name="date" value={row.date || ""} /></label>
      <div class="full" style="display:flex;gap:.6rem;">
        <button class="primary" type="submit">Save</button>
        <form method="POST" enctype="application/x-www-form-urlencoded" onsubmit="return confirm('Delete?')">
          <input type="hidden" name="action" value="delete" />
          <button class="badge danger" type="submit">Delete</button>
        </form>
      </div>
    </form>
    <pre style="margin-top:12px">{JSON.stringify(row,null,2)}</pre>
  </Card>
</Layout>
