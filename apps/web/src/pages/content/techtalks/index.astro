---
import Card from "@/components/Card.astro";
import Layout from "@/components/Layout.astro";
import Pager from "@/components/Pager.astro";
import { del, get, paginateDefaults, patch, post } from "@/lib/api";

const url = new URL(Astro.request.url);
const limit = Number(url.searchParams.get("limit") ?? paginateDefaults.limit);
const offset = Number(url.searchParams.get("offset") ?? paginateDefaults.offset);

let rows = await get<any[]>("/techtalks", { limit, offset });

const ct = (Astro.request.headers.get("content-type") || "").toLowerCase();
const isPost = Astro.request.method === "POST";
const isForm = isPost && (ct.includes("application/x-www-form-urlencoded") || ct.startsWith("multipart/form-data"));
const isJson = isPost && ct.includes("application/json");

let msg = "";
if (isForm || isJson) {
  try {
    const p = isJson ? await Astro.request.json() : Object.fromEntries((await Astro.request.formData()).entries());
    const action = String(p.action || "");

    if (action === "create") {
      await post("/techtalks", {
        user_id: Number(p.user_id),
        title: String(p.title),
        description: p.description ? String(p.description) : undefined,
        location: p.location ? String(p.location) : undefined,
        duration_min: p.duration_min ? Number(p.duration_min) : undefined,
        video_url: p.video_url ? String(p.video_url) : undefined,
        thumbnail_url: p.thumbnail_url ? String(p.thumbnail_url) : undefined,
        date: p.date ? String(p.date) : undefined
      });
    } else if (action === "update") {
      const id = Number(p.id);
      await patch(`/techtalks/${id}`, {
        title: String(p.title),
        description: p.description ? String(p.description) : undefined,
        location: p.location ? String(p.location) : undefined,
        duration_min: p.duration_min ? Number(p.duration_min) : undefined,
        video_url: p.video_url ? String(p.video_url) : undefined,
        thumbnail_url: p.thumbnail_url ? String(p.thumbnail_url) : undefined,
        date: p.date ? String(p.date) : undefined
      });
    } else if (action === "delete") {
      await del(`/techtalks/${Number(p.id)}`);
    }
    return Astro.redirect(`/content/techtalks?limit=${limit}&offset=${offset}`);
  } catch (e:any) { msg = e.message || String(e); }
}
---

<Layout title="TechTalks">
  <Card title="Create Techtalk">
    {msg && <div class="badge">{msg}</div>}
    <form method="POST" enctype="application/x-www-form-urlencoded" class="grid">
      <input type="hidden" name="action" value="create" />
      <label><span>User ID</span><input name="user_id" required /></label>
      <label class="full"><span>Title</span><input name="title" required /></label>
      <label class="full"><span>Description</span><input name="description" /></label>
      <label><span>Location</span><input name="location" /></label>
      <label><span>Duration (min)</span><input type="number" name="duration_min" min="0" /></label>
      <label class="full"><span>Video URL</span><input name="video_url" /></label>
      <label class="full"><span>Thumbnail URL</span><input name="thumbnail_url" /></label>
      <label><span>Date</span><input type="date" name="date" /></label>
      <div class="full"><button class="primary" type="submit">Add</button></div>
    </form>
  </Card>

  <Card title="Techtalks">
    <table class="tbl">
      <thead><tr><th>ID</th><th>User</th><th>Title</th><th>Date</th><th style="width:520px">Actions</th></tr></thead>
      <tbody>
        {rows.map((r:any)=>(
          <tr>
            <td><a href={`/content/techtalks/${r.id}`}>{r.id}</a></td>
            <td>{r.userId ?? ""}</td>
            <td class="clip">{r.title}</td>
            <td>{r.date ?? ""}</td>
            <td>
              <form method="POST" enctype="application/x-www-form-urlencoded" class="inline">
                <input type="hidden" name="action" value="update" />
                <input type="hidden" name="id" value={r.id} />
                <input name="title" value={r.title} placeholder="title" />
                <input name="location" value={r.location || ""} placeholder="location" />
                <input type="number" name="duration_min" value={r.durationMin ?? ""} placeholder="min" style="width:90px" />
                <input type="date" name="date" value={r.date || ""} />
                <button class="badge" type="submit">Save</button>
              </form>
              <form method="POST" enctype="application/x-www-form-urlencoded" class="inline">
                <input type="hidden" name="action" value="delete" />
                <input type="hidden" name="id" value={r.id} />
                <button class="badge danger" type="submit">Delete</button>
              </form>
              <a class="badge" href={`/content/techtalks/${r.id}`}>Detail</a>
            </td>
          </tr>
        ))}
      </tbody>
    </table>
    <Pager basePath="/content/techtalks" limit={limit} offset={offset}/>
  </Card>

  <style lang="scss">
    .grid{display:grid;grid-template-columns:repeat(2,minmax(0,1fr));gap:.6rem .8rem}.grid .full{grid-column:1/-1}
    .inline{display:inline-flex;gap:.4rem;flex-wrap:wrap;align-items:center;margin-right:.4rem}
    .tbl{width:100%;border-collapse:collapse;background:#fff;border:1px solid #eee}th,td{padding:.6rem .5rem;border-bottom:1px solid #f0f0f0;text-align:left}
    .clip{max-width:260px;white-space:nowrap;overflow:hidden;text-overflow:ellipsis}
    .badge{border:1px solid #ccc;padding:.3rem .5rem;border-radius:.4rem;background:#fafafa;cursor:pointer;text-decoration:none}.badge.danger{border-color:#e04545;color:#e04545}
    .primary{padding:.45rem .75rem;border:1px solid #ddd;border-radius:.5rem;background:#222;color:#fff;cursor:pointer}
  </style>
</Layout>
