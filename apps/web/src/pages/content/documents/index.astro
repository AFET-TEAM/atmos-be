---
import Card from "@/components/Card.astro";
import Layout from "@/components/Layout.astro";
import { del, get, patch, post } from "@/lib/api";

// Query params
const url = new URL(Astro.request.url);
const page = Number(url.searchParams.get("page") || 1);
const limit = Number(url.searchParams.get("limit") || 20);
const offset = (page - 1) * limit;

// (ileride backend buildFilters ile genişletilebilir)
const title = url.searchParams.get("title") || "";
const user_id = url.searchParams.get("user_id") || "";
const date_from = url.searchParams.get("date_from") || "";
const date_to = url.searchParams.get("date_to") || "";

// şimdilik sadece sayfalama
const q: any = { limit, offset };

let rows = await get<any[]>("/documents", q);
let msg = "";

// ---- güvenli body parse (form/json)
const ct = (Astro.request.headers.get("content-type") || "").toLowerCase();
const isPost = Astro.request.method === "POST";
const isFormPost =
  isPost &&
  (ct.includes("application/x-www-form-urlencoded") ||
    ct.startsWith("multipart/form-data"));
const isJsonPost = isPost && ct.includes("application/json");

if (isFormPost || isJsonPost) {
  try {
    const payload: Record<string, any> = isJsonPost
      ? await Astro.request.json()
      : Object.fromEntries((await Astro.request.formData()).entries());

    const action = String(payload.action || "");
    if (action === "create") {
      await post("/documents", {
        user_id: Number(payload.user_id),
        title: String(payload.title),
        description: String(payload.description || ""),
        file_url: String(payload.file_url || ""),
        date: String(payload.date || "") || null,
      });
    } else if (action === "update") {
      const id = Number(payload.id);
      await patch(`/documents/${id}`, {
        title: String(payload.title),
        description: String(payload.description || ""),
        file_url: String(payload.file_url || ""),
        date: String(payload.date || "") || null,
      });
    } else if (action === "delete") {
      const id = Number(payload.id);
      await del(`/documents/${id}`);
    }

    // mevcut filtreleri koru
    return Astro.redirect(`/content/documents?${url.searchParams.toString()}`);
  } catch (e: any) {
    msg = e?.message || String(e);
  }
}

// sayfalama link helper
const mkLink = (p: number) => {
  const sp = new URLSearchParams(url.searchParams);
  sp.set("page", String(p));
  sp.set("limit", String(limit));
  return `/content/documents?${sp.toString()}`;
};
---

<Layout title="Documents">
  <Card title="Filter">
    <form method="GET" class="toolbar">
      <input name="title" placeholder="title contains…" value={title} />
      <input name="user_id" placeholder="user_id" value={user_id} />
      <input type="date" name="date_from" value={date_from} />
      <input type="date" name="date_to" value={date_to} />
      <input type="number" name="limit" min="5" max="100" step="5" value={limit} style="width:90px" />
      <button class="primary" type="submit">Apply</button>
    </form>
  </Card>

  <Card title="Create Document">
    {msg && <div class="badge">{msg}</div>}
    <form method="POST" enctype="application/x-www-form-urlencoded" class="grid">
      <input type="hidden" name="action" value="create" />
      <label>
        <span>Owner (user_id)</span>
        <input name="user_id" required />
      </label>
      <label>
        <span>Title</span>
        <input name="title" required />
      </label>
      <label class="full">
        <span>Description</span>
        <input name="description" />
      </label>
      <label class="full">
        <span>File URL</span>
        <input name="file_url" placeholder="https://…" />
      </label>
      <label>
        <span>Date</span>
        <input type="date" name="date" />
      </label>
      <div class="full">
        <button class="primary" type="submit">Add</button>
      </div>
    </form>
  </Card>

  <Card title="Documents">
    {rows?.length ? (
      <>
        <table class="tbl">
          <thead>
            <tr>
              <th>ID</th>
              <th>Owner</th>
              <th>Title</th>
              <th>File</th>
              <th>Date</th>
              <th style="width: 520px;">Actions</th>
            </tr>
          </thead>
          <tbody>
            {rows.map((r: any) => (
              <tr>
                <td><a href={`/content/documents/${r.id}`}>{r.id}</a></td>
                <td>{r.userId}</td>
                <td class="clip">{r.title}</td>
                <td class="clip">
                  {r.fileUrl ? <a href={r.fileUrl} target="_blank">open</a> : <em class="muted">n/a</em>}
                </td>
                <td>{r.date ?? ""}</td>
                <td>
                  <div class="actions">
                    {/* Inline Update */}
                    <form method="POST" enctype="application/x-www-form-urlencoded" class="form-inline">
                      <input type="hidden" name="action" value="update" />
                      <input type="hidden" name="id" value={r.id} />
                      <input name="title" value={r.title} placeholder="title" style="min-width:180px" />
                      <input name="description" value={r.description || ""} placeholder="description" style="min-width:220px" />
                      <input name="file_url" value={r.fileUrl || ""} placeholder="file url" style="min-width:220px" />
                      <input type="date" name="date" value={r.date || ""} />
                      <button class="badge" type="submit">Save</button>
                    </form>

                    {/* Delete */}
                    <form method="POST" enctype="application/x-www-form-urlencoded" class="form-inline">
                      <input type="hidden" name="action" value="delete" />
                      <input type="hidden" name="id" value={r.id} />
                      <button class="badge danger" type="submit">Delete</button>
                    </form>

                    <a class="badge" href={`/content/documents/${r.id}`}>Detail</a>
                  </div>
                </td>
              </tr>
            ))}
          </tbody>
        </table>

        <div class="pager">
          <a class="badge" href={mkLink(Math.max(1, page - 1))} aria-disabled={page<=1}>« Prev</a>
          <span>Page {page}</span>
          <a class="badge" href={mkLink(page + 1)}>Next »</a>
        </div>
      </>
    ) : (
      <p class="muted">No documents found.</p>
    )}
  </Card>

  <style lang="scss">
    .toolbar { display:flex; gap:.5rem; flex-wrap:wrap; }
    .grid { display:grid; grid-template-columns: repeat(2, minmax(0,1fr)); gap:.6rem .8rem; }
    .grid .full { grid-column: 1 / -1; }
    .grid label { display:flex; flex-direction:column; gap:.3rem; }
    .tbl { width:100%; border-collapse:collapse; background:#fff; border:1px solid #eee; }
    th, td { padding:.6rem .5rem; border-bottom:1px solid #f0f0f0; vertical-align:top; text-align:left; }
    .clip { max-width:260px; white-space:nowrap; overflow:hidden; text-overflow:ellipsis; }
    .actions { display:flex; gap:.5rem; align-items:center; flex-wrap:wrap; }
    .form-inline { display:inline-flex; gap:.5rem; align-items:center; flex-wrap:wrap; }
    .badge { border:1px solid #ccc; padding:.3rem .5rem; border-radius:.4rem; background:#fafafa; cursor:pointer; text-decoration:none; }
    .badge.danger { border-color:#e04545; color:#e04545; }
    .badge[aria-disabled="true"] { opacity:.4; pointer-events:none; }
    .primary { padding:.45rem .75rem; border:1px solid #ddd; border-radius:.5rem; background:#222; color:#fff; cursor:pointer; }
    .muted { color:#666; }
    .pager { margin-top:.8rem; display:flex; gap:.6rem; align-items:center; }
  </style>
</Layout>
