---
import Layout from "@/components/Layout.astro";
import Card from "@/components/Card.astro";
import Table from "@/components/Table.astro";
import { get } from "@/lib/api";
const id = Astro.params.id!;
const team = await get<any>(`/teams/${id}`);
const members = await get<any[]>(`/teams/${id}/members`, { limit: 50, offset: 0 });
---
<Layout title={`Team #${id}`}>
  <div class="row">
    <div class="col-6"><Card title="Team"><pre>{JSON.stringify(team, null, 2)}</pre></Card></div>
    <div class="col-6"><Card title="Members"><Table rows={members} cols={[
      { key: "id", label: "ID" },
      { key: "fullName", label: "Full Name" },
      { key: "email", label: "Email" }
    ]} /></Card></div>
  </div>
</Layout>
