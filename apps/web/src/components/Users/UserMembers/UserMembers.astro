---
import { getUserTeamMembers } from '@/api/UsersApi';
import IconButton from "@/components/UI/IconButton.astro";
import UserAvatar from "../UserAvatar/UserAvatar.astro";
import "./usermembers.scss";
const { user } = Astro.props;

type teamMembers = {
  id: number;
  name: string;
  status: boolean;
  profilePicture: string;
};


const getUserTeamMember = await getUserTeamMembers(user?.id);

---

<div class="team-members-card">
  <p class="card-tag">Teams</p>
  <ul class="team-members">
    {
      getUserTeamMember?.map((users: teamMembers) => (
        <li class="team-member" data-key={users.id}>
          <UserAvatar imageSize="user-image-md" user={users} />

          <div class="buttons">
            <IconButton
              buttonType="secondary"
              color="#18a0fb"
              iconName="addFriends"
            />
            <IconButton buttonType="primary" color="#18a0fb" iconName="send" />
          </div>
        </li>
      ))
    }
  </ul>
</div>
