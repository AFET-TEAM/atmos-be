---
import IconButton from "@/components/UI/IconButton.astro";
import UserAvatar from "../UserAvatar/UserAvatar.astro";
const { user } = Astro.props;
import "./usermembers.scss";

type teamMembers = {
  id: number;
  name: string;
  status: boolean;
  profilePicture: string;
};
---

<div class="team-members-card">
  <p class="card-tag">Teams</p>
  <ul class="team-members">
    {
      user.teamMembers.map((team: teamMembers) => (
        <li class="team-member" data-key={team.id}>
          <UserAvatar imageSize="user-image-md" user={team} />

          <div class="buttons">
            <IconButton
              buttonType="secondary"
              color="#18a0fb"
              iconName="addFriends"
            />
            <IconButton buttonType="primary" color="#18a0fb" iconName="send" />
          </div>
        </li>
      ))
    }
  </ul>
</div>
