---
import { getUserTeamMembers } from '@/api/UsersApi';
import CustomLink from '@/components/UI/CustomLink.astro';
import IconButton from "@/components/UI/IconButton.astro";
import UserAvatar from "../UserAvatar/UserAvatar.astro";
import "./usermembers.scss";
const { user } = Astro.props;

type teamMembers = {
  id: number;
  fullName: string;
  status: boolean;
  profilePicture: string;
};

const toSlug = (s: string) =>
  s
    .trim()
    .toLowerCase()
    .replace(/\u00A0/g, " ")
    .replace(/\s+/g, "-");

const makeUserSlug = (u: any) => encodeURIComponent(toSlug(String(u?.fullName ?? "")));
const getUserTeamMember = await getUserTeamMembers(user?.id);

---

<div class="team-members-card">
  <p class="card-tag">Teams</p>
  <ul class="team-members">
    {
      getUserTeamMember?.map((users: teamMembers) => (
        <li class="team-member" data-key={users.id}>
         <div class="user-avatar-wrapper">
           <UserAvatar imageSize="user-image-md" user={users} />

          <div class="user-info">
            <h4>{users.fullName}</h4>

          </div>
         </div>

          <div class="buttons">
            <CustomLink
              buttonType="secondary"
              iconName="addFriends"
              href={`/users/${makeUserSlug(users)}`}
              color="#666666"
             className="icon-button-secondary"
            />
            <IconButton buttonType="primary" iconName="send" />
          </div>
        </li>
      ))
    }
  </ul>
</div>
