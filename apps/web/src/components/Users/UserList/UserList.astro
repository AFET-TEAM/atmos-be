---
import "./user-list.scss";
import Icon from "../../../../public/icons/icon.astro";
import { getUsers } from "@/api/UsersApi";
import UserAvatar from "../UserAvatar/UserAvatar.astro";
const $users = await getUsers();

console.log("UserList users:", $users);

let isDropdownVisible = false;
---

<section class="cards-container">
  {
    $users.map((user: any) => (
      <a href={`/users/${user.id}`}>
        <div class="card">
          <div class="image-container">
            <UserAvatar imageSize="user-image-md" user={user} />
          </div>
          <div class="content">
            <div class="badge">{user.profession}</div>
            <h3>{user.full_name}</h3>
            <div class="info">
              <Icon
                name={"adjustmentIcon"}
                width={11}
                height={11}
                color={"none"}
              />
              <p>{user.userDepartment}</p>
            </div>
            <div class="info">
              <Icon name={"mail"} width={11} height={11} color={"none"} />
              <p>{user.email}</p>
            </div>
          </div>
          <div class="buttons-container">
            <div class="user-bubbles">
              {user?.teamMembers?.slice(0, 3).map((member: any) => (
                <div class="user-bubble">
                  <img src={member.profilePicture} alt={member.full_name} />
                </div>
              ))}
              {user?.teamMembers?.length > 3 && (
                <div
                  class="user-bubble more-users"
                  onmouseover="isDropdownVisible = true"
                  onmouseleave="isDropdownVisible = false"
                >
                  <span>+{user.teamMembers.length - 3}</span>
                  {isDropdownVisible && (
                    <div>
                      {user.teamMembers.map((member: any) => (
                        <div class="dropdown-item">
                          <img
                            src={member.profilePicture}
                            alt={member.full_name}
                          />
                          <span>{member.full_name}</span>
                        </div>
                      ))}
                    </div>
                  )}
                </div>
              )}
            </div>
            <button class={user.connection}>
              Connect
              {user.connection !== "disable" && (
                <Icon name={"send"} size={14} className="icon" color={"none"} />
              )}
            </button>
          </div>
        </div>
      </a>
    ))
  }
</section>
