---
const { meets } = Astro.props;
import "./meet-list.scss";

const hasMeets = Array.isArray(meets) && meets.length > 0;
---

<section class="meetings-container">
  <div class="meet-header">
    <span>Meeting Schedule</span>
  </div>

  {hasMeets ? (
    <div class="meet-list">
      {meets.map((meet: any) => (
        <div class="meet-item">
          <div class="timeline" />
          <div class="meet-content">
            <h3 class="meet-title">{meet.title}</h3>
            <p class="meet-time">{meet.time}</p>
          </div>
        </div>
      ))}
    </div>
  ) : (
    <div class="meet-empty">No scheduled meetings.</div>
  )}
</section>
