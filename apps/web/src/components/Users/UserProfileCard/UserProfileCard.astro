---
const { user } = Astro.props;
import Icon from "../../../../public/icons/icon.astro";
import UserAvatar from "../UserAvatar/UserAvatar.astro";
import "../users.scss";
---

<article class="user-profile-card-wrapper">
  <div class="user-profile-card">
    <UserAvatar
      user={user}
      imageSize="user-image-lg"
      disableIndicator={false}
    />

    <div class="user-profile-info">
      <h2>{user.fullName}</h2>
      <div class="job">
        <p>{user.jobvalue}</p>
      </div>
      <div class="address-info">
        <Icon name={"locationIcon"} />
        <p>{user?.address}</p>
      </div>
    </div>
  </div>
</article>
