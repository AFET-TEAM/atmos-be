---
import IconButton from "@/components/UI/IconButton.astro";
import SearchInput from "@/components/UI/SearchInput.astro";
import { getUser } from '@/stores/userStore';
import Icon from "public/icons/icon.astro";
import LogoutButton from "../LogoutButton.svelte";
import "./Header.scss";


const user = getUser();
console.log("Header user:", user);
---

<header class="header">
  <div class="header-left">
    <IconButton buttonType="primary" color="#18a0fb" iconName="send" />
    <SearchInput />
  </div>

  <div class="header-right">
    <div class="icon"><Icon name="mail" /></div>
    <div class="icon"><Icon name="notification" /></div>
    <div class="avatar">
      <span class="user-name" id="header-user-name">{user?.full_name || "Kullanıcı"}</span>
      <div class="image-wrapper">
        <img
          class="avatar-img"
          id="header-user-avatar"
          src={user?.profile_picture || "/default-avatar.png"}
          alt="avatar"
          width="32"
          height="32"
        />
      </div>
    </div>
    <LogoutButton client:load />
  </div>
</header>


