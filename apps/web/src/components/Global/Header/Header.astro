---
import { getUser } from '@/stores/userStore';
import Icon from "public/icons/icon.astro";
import LogoutButton from "../LogoutButton.svelte";
import NotificationHeader from "../NotificationHeader/NotificationHeader.astro";
import "./Header.scss";


const user = getUser();
---

<header class="header">
 <div class="header-left">
    <a href="/dashboard" class="header-logo-link" aria-label="Dashboard">
      <img
        src="/img/logo.png"
        alt="ATOS Logo"
        class="header-logo"
        width="40"
        height="40"
      />
    </a>
  </div>

  <div class="header-right">
    <div class="icon"><Icon name="mail" /></div>
    <NotificationHeader />
    <div class="avatar">
      <span class="user-name" id="header-user-name">{user?.full_name || "Kullanıcı"}</span>
      <div class="image-wrapper">
        <img
          class="avatar-img"
          id="header-user-avatar"
          src={user?.profile_picture ? user.profile_picture : user?.gender === "female" ? "/DefaultImageWoman.png" : "/DefaultImageMan.png"}
          alt="avatar"
          width="32"
          height="32"
        />
      </div>
    </div>
    <LogoutButton client:load />
    <button
      class="hamburger-btn"
      type="button"
      aria-label="Toggle sidebar"
      data-toggle-sidebar
    >
      <svg
        viewBox="0 0 24 24"
        fill="none"
        stroke="#333"
        stroke-width="2"
        stroke-linecap="round"
        stroke-linejoin="round"
      >
        <line x1="3" y1="6" x2="21" y2="6" />
        <line x1="3" y1="12" x2="21" y2="12" />
        <line x1="3" y1="18" x2="21" y2="18" />
      </svg>
    </button>
  </div>
</header>


