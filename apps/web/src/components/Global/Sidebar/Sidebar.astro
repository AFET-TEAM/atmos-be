---
import CustomLink from "@/components/UI/CustomLink.astro";
import RoleGate from '@/components/UI/RoleGate.astro';
import LogoutButton from "../LogoutButton.svelte";
import "./sidebar.scss";
---

<article class="sidebar">
  <button
    class="sidebar-close"
    type="button"
    aria-label="Close menu"
    data-toggle-sidebar
  >
    <svg
      viewBox="0 0 24 24"
      width="18"
      height="18"
      stroke="#555"
      stroke-width="2"
      fill="none"
      stroke-linecap="round"
      stroke-linejoin="round"
    >
      <line x1="5" y1="5" x2="19" y2="19" />
      <line x1="19" y1="5" x2="5" y2="19" />
    </svg>
  </button>
  <div class="logo">
    <img class="sidebar-logo" src="/img/logo.png" alt="Logo" />
  </div>

  <div class="links">
    <CustomLink
      color="#18a0fb"
      text="Dashboard"
      href="/dashboard"
      iconName="dots"
    />
    <CustomLink text="Users" href="/users" iconName="users" />
    <CustomLink text="Documents" href="/documents" iconName="document" />
    <CustomLink text="TechTalks" href="/techtalks" iconName="mic" />
    <CustomLink text="Ideas" href="/ideas" iconName="lamp" />
<CustomLink text="Edit Users" href="/edit-users" iconName="users" />
      <CustomLink text="Announcements" href="/add-announcements" iconName="notification" />

    <RoleGate roles={["admin"]}>
      <CustomLink text="Edit Users" href="/edit-users" iconName="users" />
      <CustomLink text="Announcements" href="/add-announcements" iconName="notification" />
    </RoleGate>

    <LogoutButton client:load className="customLink logout-sidebar" />

  </div>
</article>
