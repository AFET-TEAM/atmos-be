---
import "./techtalk-card.scss";
import Icon from "../../../../public/icons/icon.astro";
//bunlar servisten gelecek.
const img = 'data:image/jpeg;base64,';
---
<div class="techtalk-card">
    <div class="card-image-container">
        <div class="tech-talk-badge">TechTalk of Week</div>
        <img src={img} alt="TechTalk Görseli" class="card-image" />
    </div>
    <div class="card-content">
        <div class="header-row">
            <div class="date-badge">
                <span class="day">20</span>
                <span class="month">OCA</span>
            </div>
            <div class="title-description">
                <h2 class="title">Svelte 5 Öğreniyoruz</h2>
                <p class="description">Description about TechTalks</p>
            </div>
        </div>

        <div class="info-item">
            <Icon name={"mic"} width={8} height={14}/>
            <span class="info-text">Barış Benli</span>
        </div>
        <div class="info-item">
            <Icon name={"date"} width={8} height={14}/>
            <span class="info-text">20.01.2025 - 16:00</span>
        </div>
        <div class="info-item">
            <Icon name={"locationIcon"} width={8} height={14}/>
            <a href="#" class="info-text link">Katıl</a>
        </div>
    </div>
</div>
