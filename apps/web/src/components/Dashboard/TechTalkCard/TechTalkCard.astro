---
import { fetchLastTechTalk } from "@/api/TechTalksApi";
import moment from "moment";
import Icon from "../../../../public/icons/icon.astro";
import "./techtalk-card.scss";

const techTalks = await fetchLastTechTalk();
const hasTalks = Array.isArray(techTalks) && techTalks.length > 0;
---

{hasTalks ? (
  <section class="techtalks-slider-root">
    <div class="techtalks-slider-viewport" id="techtalkSlider">
      <div class="techtalks-slider-track">
        {
          techTalks.map((talk: any) => {
            const techTalkDate = moment(talk.date).format("DD MMM YYYY - HH:mm");
            const techTalkDay = moment(talk.date).format("DD");
            const techTalkMonth = moment(talk.date).format("MMM");

            return (
              <article class="techtalk-card">
                <div class="card-image-container">
                  <div class="tech-talk-badge">TechTalk of Week</div>
                  <img
                    src={talk.thumbnail_url ? talk.thumbnail_url : "/TechTalkDefaultImg.png"}
                    alt="TechTalk Görseli"
                    class="card-image"
                  />
                </div>

                <div class="card-content">
                  <div class="header-row">
                    <div class="date-badge">
                      <span class="day">{techTalkDay}</span>
                      <span class="month">{techTalkMonth}</span>
                    </div>

                    <div class="title-description">
                      <h2 class="title">{talk.title}</h2>
                      <p class="description">{talk.description}</p>
                    </div>
                  </div>

                  <div class="info-item">
                    <Icon name={"mic"} width={8} height={14} />
                    <span class="info-text">Konuşmacı bilgisi yakında</span>
                  </div>

                  <div class="info-item">
                    <Icon name={"date"} width={8} height={14} />
                    <span class="info-text">{techTalkDate}</span>
                  </div>
                </div>
              </article>
            );
          })
        }
      </div>

      <button
        type="button"
        class="techtalk-arrow techtalk-arrow--prev"
        aria-label="Önceki TechTalk"
      >
        ‹
      </button>
      <button
        type="button"
        class="techtalk-arrow techtalk-arrow--next"
        aria-label="Sonraki TechTalk"
      >
        ›
      </button>
    </div>

    <div class="techtalk-dots" id="techtalkDots">
      {
        techTalks.map((_, idx) => (
          <button
            type="button"
            class={`techtalk-dot ${idx === 0 ? "is-active" : ""}`}
            data-index={idx}
            aria-label={`TechTalk ${idx + 1}`}
          />
        ))
      }
    </div>
  </section>
) : (
  <p>Çok yakında yeni konular ile karşınızda....</p>
)}

<script is:inline>
  (() => {
    const initSlider = () => {
      const slider = document.getElementById("techtalkSlider");
      if (!slider) return;

      slider.dataset.init = "";

      if (slider.dataset.init === "1") return;
      slider.dataset.init = "1";

      const track = slider.querySelector(".techtalks-slider-track");
      const slides = track ? Array.from(track.children) : [];
      const prevBtn = slider.querySelector(".techtalk-arrow--prev");
      const nextBtn = slider.querySelector(".techtalk-arrow--next");
      const dotsContainer = document.getElementById("techtalkDots");
      const dots = dotsContainer
        ? Array.from(dotsContainer.querySelectorAll(".techtalk-dot"))
        : [];

      if (!track || slides.length === 0) return;

      let index = 0;

      const updatePosition = () => {
        const width = slider.getBoundingClientRect().width;
        track.style.transform = `translateX(${-index * width}px)`;
      };

      const updateDots = () => {
        dots.forEach((dot, i) => dot.classList.toggle("is-active", i === index));
      };

      const goTo = (newIndex) => {
        const total = slides.length;
        index = ((newIndex % total) + total) % total;
        updatePosition();
        updateDots();
      };

      updatePosition();
      updateDots();

      prevBtn?.addEventListener("click", () => goTo(index - 1));
      nextBtn?.addEventListener("click", () => goTo(index + 1));
      dots.forEach((dot, i) => dot.addEventListener("click", () => goTo(i)));

      window.addEventListener("resize", updatePosition);
    };

    initSlider();
    document.addEventListener("astro:page-load", initSlider);
  })();
</script>


