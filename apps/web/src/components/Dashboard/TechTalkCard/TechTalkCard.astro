---
import { fetchLastTechTalk } from '@/api/TechTalksApi';
import { getUserById } from '@/api/UsersApi';
import moment from 'moment';
import Icon from "../../../../public/icons/icon.astro";
import "./techtalk-card.scss";
const lastTechTalks = await fetchLastTechTalk();
const getTechTalkAuthor = await getUserById(lastTechTalks.user_id);
const techTalkDate = moment(lastTechTalks.date).format("DD MMM YYYY - HH:mm");
const techTalkDay = moment(lastTechTalks.date).format("DD");
const techTalkMonth = moment(lastTechTalks.date).format("MMM")

---
<div class="techtalk-card">
   {
    lastTechTalks ? (
     <div class="card-image-container">
        <div class="tech-talk-badge">TechTalk of Week</div>
        <img src={lastTechTalks.thumbnail_url ? lastTechTalks.thumbnail_url : "/TechTalkDefaultImg.png"} alt="TechTalk Görseli" class="card-image" />
    </div>
    <div class="card-content">
        <div class="header-row">
            <div class="date-badge">
                <span class="day">{techTalkDay}</span>
                <span class="month">{techTalkMonth}</span>
            </div>
            <div class="title-description">
                <h2 class="title">{lastTechTalks.title}</h2>
                <p class="description">{lastTechTalks.description}</p>
            </div>
        </div>

        <div class="info-item">
            <Icon name={"mic"} width={8} height={14}/>
            <span class="info-text">{getTechTalkAuthor?.name}</span>
        </div>
        <div class="info-item">
            <Icon name={"date"} width={8} height={14}/>
            <span class="info-text">{techTalkDate}</span>
        </div>
        {/* <!-- <div class="info-item">
            <Icon name={"locationIcon"} width={8} height={14}/>
            <a href="#" class="info-text link">Katıl</a>
        </div> --> */}
    </div>
    ) : (
      <p>Çok yakında yeni konular ile karşınızda....</p>
    )
   }
</div>
