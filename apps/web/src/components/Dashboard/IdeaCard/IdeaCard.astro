---
import "./idea-card.scss";
import Icon from "../../../../public/icons/icon.astro";

---
<a href="/ideas" class="idea-card">
    <div class="card-container">
        <Icon name={"lamp"} width={15} height={15} stroke="#fff"/>
        <div class="text-content">
            <div class="header">
                <span>Bir Fikrim Var!</span>
            </div>
            <p class="content">
                Fikirlerin bizim için değerli. Aklına bir bir fikir mi geldi bizimle paylaşmak ve hayata
                geçirmeye ne dersin?
            </p>
        </div>
    </div>
</a>