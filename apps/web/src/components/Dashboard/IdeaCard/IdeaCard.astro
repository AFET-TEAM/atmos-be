---
import "./idea-card.scss";
import Icon from "../../../../public/icons/icon.astro";

---
<a href="/ideas" class="idea-card">
    <div class="card-container">
        <Icon name={"lamp"} width={15} height={15} stroke="#fff"/>
        <div class="text-content">
            <div class="idea-header">
                <span>I Have an Idea!</span>
            </div>
            <p class="content">
                Your ideas matter to us. Have a great idea in mind ?  Why not share it with us and help bring it to life ?
            </p>
        </div>
    </div>
</a>