---
import Icon from "../../../../public/icons/icon.astro";
import "./links-card.scss";

type ImportantLink = {
    key: string;
    value: string;
    id: string;
};


 const importantLinks: ImportantLink[] = [
    {
      "key": "hrLife",
      "value": "HR Life",
      "id": "c22f"
    },
    {
      "key": "kronos",
      "value": "Kronos",
      "id": "a21d"
    },
    {
      "key": "keyFlow",
      "value": "KeyFlow",
      "id": "3ff8"
    },
    {
      "key": "oneFlow",
      "value": "One Flow",
      "id": "6607"
    }
  ]

---

<div class="links-card-container">
    <div class="badge-area">
        <div class="links-badge">Important Links</div>
    </div>

    <div class="content-area">
        <div class="links-grid">
            {
                importantLinks.map((link) => (
                        <a href={link.key} class="link-item">
                            <Icon name={"links"} />
                            <span>{link.value}</span>
                        </a>
                ))
            }
        </div>
    </div>
</div>
