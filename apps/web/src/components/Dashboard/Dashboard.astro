---
import "./dashboard.scss";
import Calendar from "./Calendar/Calendar.svelte";
import WelcomeCard from "./WelcomeCard/WelcomeCard.astro";
import StatsCard from "./StatsCard/StatsCard.astro";
import TotalTaskCard from "./TotalTaskCard/TotalTaskCard.astro";
import TechTalkCard from "./TechTalkCard/TechTalkCard.astro";
import LinksCard from "./LinksCard/LinksCard.astro";
import IdeaCard from "./IdeaCard/IdeaCard.astro";
import MapCard from "./MapCard/MapCard.astro";
import AnnouncementsCard from "./AnnouncementsCard/AnnouncementsCard.astro";


---

<div class="dashboard">
 <div class="top-section">
    <div class="left-group">
      <div class="top-cards-row">
        <div class="card">
          <WelcomeCard/>
        </div>

        <div class="announcements">
          <AnnouncementsCard/>
        </div>
      </div>

      <div class="stats-row">
        <StatsCard/>
      </div>
    </div>

    <div class="calendar-card">
      <Calendar client:load/>
    </div>
  </div>
  <div class="middle-section">
    <!--<div class="card">
      <TotalTaskCard/>
    </div>-->
    <div class="card">
      <TechTalkCard/>
    </div>
    <div class="card">
      <LinksCard/>
    </div>
  </div>

  <div class="bottom-section">
    <div class="card">
      <IdeaCard/>
    </div>
    <div class="card">
      <MapCard/>
    </div>
  </div>
</div>

<script>
  import { tokenManager } from '@/axios/axiosInstance';

  document.addEventListener('DOMContentLoaded', () => {

    const cookieToken = document.cookie
      .split('; ')
      .find(row => row.startsWith('auth='))
      ?.split('=')[1];

    const cookieUser = document.cookie
      .split('; ')
      .find(row => row.startsWith('user='))
      ?.split('=')[1];

    if (cookieToken && !tokenManager.getToken()) {
      tokenManager.setToken(cookieToken);

      if (cookieUser) {
        try {
          const userData = JSON.parse(decodeURIComponent(cookieUser));
          tokenManager.setUser(userData);
        } catch (e) {
          console.error('User cookie parse error:', e);
        }
      }
    }


    const token = tokenManager.getToken();

    if (!token) {
      window.location.href = '/auth/login';
      return;
    }

    if (tokenManager.isTokenExpired(token)) {
      tokenManager.removeToken();
      window.location.href = '/auth/login';
      return;
    }

  });
</script>
