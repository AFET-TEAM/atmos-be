---
import "./dashboard.scss";
import Calendar from "./Calendar/Calendar.svelte";
import WelcomeCard from "./WelcomeCard/WelcomeCard.astro";
import StatsCard from "./StatsCard/StatsCard.astro";
import TotalTaskCard from "./TotalTaskCard/TotalTaskCard.astro";
import TechTalkCard from "./TechTalkCard/TechTalkCard.astro";
import LinksCard from "./LinksCard/LinksCard.astro";
import IdeaCard from "./IdeaCard/IdeaCard.astro";
import MapCard from "./MapCard/MapCard.astro";
import AnnouncementsCard from "./AnnouncementsCard/AnnouncementsCard.astro";

const announcements = [
  {
    id: "a1",
    title: "Atos Planı",
    date: "18.12.2025",
    content:
      "Atos v1.0 sürümü çok yakında yayınlanacaktır. Yeni özellikler ve iyileştirmeler için hazırlanın.",
    authorName: "Barış Benli",
    authorRole: "Yönetici",
  },
  {
    id: "a2",
    title: "TechTalk Saati Güncellendi",
    date: "17.12.2025",
    content:
      "TechTalk etkinliği 16:00 yerine 16:30'a alınmıştır. Takvimlerinizi güncelleyebilirsiniz.",
    authorName: "Barış Benli",
    authorRole: "Yönetici",
  },
  {
    id: "a3",
    title: "Lorem Ipsum",
    date: "16.12.2025",
    content:
      "lorem ipsum dolor sit amet, consectetur adipiscing elit, sed do eiusmod tempor incididunt ut labore et dolore magna aliqua.",
    authorName: "Barış Benli",
    authorRole: "Yönetici",
  },
];
---

<div class="dashboard">
 <div class="top-section">
    <div class="left-group">
      <div class="top-cards-row">
        <div class="card">
          <WelcomeCard/>
        </div>

        <div class="announcements">
          <AnnouncementsCard announcements={announcements}/>
        </div>
      </div>

      <div class="stats-row">
        <StatsCard/>
      </div>
    </div>

    <div class="calendar">
      <Calendar client:load/>
    </div>
  </div>
  <div class="middle-section">
    <!--<div class="card">
      <TotalTaskCard/>
    </div>-->
    <div class="card">
      <TechTalkCard/>
    </div>
    <div class="card">
      <LinksCard/>
    </div>
  </div>

  <div class="bottom-section">
    <div class="card">
      <IdeaCard/>
    </div>
    <div class="card">
      <MapCard/>
    </div>
  </div>
</div>

<script>
  import { tokenManager } from '@/axios/axiosInstance';

  document.addEventListener('DOMContentLoaded', () => {

    const cookieToken = document.cookie
      .split('; ')
      .find(row => row.startsWith('auth='))
      ?.split('=')[1];

    const cookieUser = document.cookie
      .split('; ')
      .find(row => row.startsWith('user='))
      ?.split('=')[1];

    if (cookieToken && !tokenManager.getToken()) {
      console.log('📥 Dashboard: Copying token from cookie to localStorage');
      tokenManager.setToken(cookieToken);

      if (cookieUser) {
        try {
          const userData = JSON.parse(decodeURIComponent(cookieUser));
          tokenManager.setUser(userData);
        } catch (e) {
          console.error('User cookie parse error:', e);
        }
      }
    }


    const token = tokenManager.getToken();
    console.log('🔍 Dashboard auth check:', {
      hasToken: !!token,
      isExpired: token ? tokenManager.isTokenExpired(token) : null
    });

    if (!token) {
      console.log('❌ No token found, redirecting to login');
      window.location.href = '/auth/login';
      return;
    }

    if (tokenManager.isTokenExpired(token)) {
      console.log('⏰ Token expired, redirecting to login');
      tokenManager.removeToken();
      window.location.href = '/auth/login';
      return;
    }

    console.log('✅ Authentication successful, staying on dashboard');
  });
</script>
