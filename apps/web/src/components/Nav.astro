---
const links = [
  { href: "/", label: "Dashboard" },
  { href: "/health", label: "Health" },
  { href: "/users", label: "Users" },
  { href: "/teams", label: "Teams" },
  { href: "/meetings", label: "Meetings" },
  { href: "/content/techtalks", label: "Techtalks" },
  { href: "/content/documents", label: "Documents" },
  { href: "/content/reports", label: "Reports" },
  { href: "/content/ideas", label: "Ideas" },
  { href: "/tasks", label: "Tasks" },
  { href: "/comments", label: "Comments" },
  { href: "/likes", label: "Likes" },
  { href: "/lookups", label: "Lookups" },
  { href: "/swagger", label: "Swagger" },
  { href: "/login", label: "Login" },
  { href: "/logout", label: "Logout" }
];
---
<div style="border-bottom:1px solid var(--border); background:#0d1117;">
  <div class="container" style="display:flex; gap:14px; padding:10px 24px;">
    {links.map((l) => <a href={l.href}>{l.label}</a>)}
  </div>
</div>
