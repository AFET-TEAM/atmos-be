---
type Col<T> = { key: keyof T | string; label: string; render?: (row: T) => any };
const { rows = [], cols = [] } = Astro.props as { rows: any[]; cols: Col<any>[] };
---
<table>
  <thead><tr>{cols.map((c) => <th>{c.label}</th>)}</tr></thead>
  <tbody>
    {rows.map((r) => (
      <tr>
        {cols.map((c) => <td set:html={c.render ? c.render(r) : (r as any)[c.key as string]} />)}
      </tr>
    ))}
  </tbody>
</table>
