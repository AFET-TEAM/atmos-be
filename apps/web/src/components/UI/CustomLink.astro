---
import Icon from "../../../public/icons/icon.astro";
import "./ui.scss";

type CustomLinkProps = {
  text: string;
  href: string;
  iconName: string;
  color?: string;
  size?: number;
  border?: boolean;
  className?: string;
};

const {
  iconName,
  text,
  href,
  color = "#18a0fb",
  size = 24,
  className = "",
  border = false,
} = Astro.props as CustomLinkProps;

const isActive =
  Astro.url.pathname === href ||
  (href !== "/" && Astro.url.pathname.startsWith(href + "/"));
---

{ text ? (
  <div class={`${className} customLink ${border ? "bordered" : ""} ${isActive ? "is-active" : ""}`}>
    <Icon name={iconName} size={size} color={isActive ? color : undefined} />

    <a href={href} class="customLinks" aria-current={isActive ? "page" : undefined}>
      {text}
    </a>
  </div>
) : (
  <a
    href={href}
    class={`${className} customLink ${border ? "bordered" : ""} ${isActive ? "is-active" : ""}`}
    aria-current={isActive ? "page" : undefined}
  >
    <Icon name={iconName} size={size} color={isActive ? color : undefined} />
  </a>
) }
