---
const { limit=20, offset=0, basePath, q={} } = Astro.props as any;
const prev = Math.max(0, offset - limit);
const next = offset + limit;
const mk = (o:number) => {
  const params = new URLSearchParams({ ...q, limit: String(limit), offset: String(o) } as any).toString();
  return `${basePath}?${params}`;
};
---
<div class="toolbar">
  <a class="badge" href={mk(prev)}>‹ Prev</a>
  <span class="badge">offset {offset}</span>
  <a class="badge" href={mk(next)}>Next ›</a>
</div>
